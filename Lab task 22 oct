#include <stdio.h>
int main(){
    int quantities[3][3];
    int prices[3][2];
    int finalprices[3][2];
    int price;
    int branch1profit, branch2profit, branch3profit;



    printf("Enter Quantities for Charger (3): ");
    for(int i = 0; i < 3; i++){
        scanf("%d", &quantities[i][0]);
    }
    printf("Enter Quantities for Earphones (3): ");
    for(int i = 0; i < 3; i++){
        scanf("%d", &quantities[i][1]);
    }
    printf("Enter Quantities for Cover (3): ");
    for(int i = 0; i < 3; i++){
        scanf("%d", &quantities[i][2]);
    }


    printf("Enter Cost Price for Charger: ");
    
        scanf("%d", &prices[0][0]);
    
    printf("Enter Selling Price for Charger: ");
    
        scanf("%d", &prices[0][1]);
