        scanf("%d", &prices[2][0]);
    
    printf("Enter Selling Price for Cover (3): ");
    
        scanf("%d", &prices[2][2]);


    // New table S * P (FinalPrices)

    for(int i = 0; i < 3; i++){
        for(int j = 0; j < 3; j++){
            price = quantities[i][j] * prices[j][i];
            finalprices[i][j] = price;
            
        }
    }

    // final table

    branch1profit = finalprices[0][1] - finalprices[0][0];
    branch2profit = finalprices[1][1] - finalprices[1][0];
    branch3profit = finalprices[2][1] - finalprices[2][0];
    
    
    printf("----Original Price----");
    for(int i = 0; i < 3; i++){
        printf("Branch %d: Cost=%d Sales=%d Profit=%d\n", i, finalprices[i][0], finalprices[i][1], finalprices[i][1] - finalprices[i][0]);
        if(branch1profit > branch2profit && branch1profit > branch3profit){
        printf("Branch 1 has the highest profit of %d\n", branch1profit);
    }
    if(branch2profit > branch1profit && branch2profit > branch3profit){
        printf("Branch 2 has the highest profit of %d", branch2profit);
    }
    if(branch3profit > branch2profit && branch3profit > branch1profit){
        printf("Branch 3 has the highest profit of %d", branch3profit);
    }
    else if((branch1profit > branch2profit && branch1profit > branch3profit) && (branch2profit > branch1profit && branch2profit > branch3profit) && (branch1profit == branch2profit)){
        printf("Branch 1 has the highest profit of %d", branch1profit);
        printf("Branch 2 has the highest profit of %d", branch2profit);
    }
    else if((branch1profit > branch2profit && branch1profit > branch3profit) && (branch3profit > branch2profit && branch3profit > branch1profit)){
        printf("Branch 1 has the highest profit of %d", branch1profit);
        printf("Branch 3 has the highest profit of %d", branch3profit);
    }
    else if((branch2profit > branch1profit && branch2profit > branch3profit) && (branch3profit > branch2profit && branch3profit > branch1profit)){
        printf("Branch 2 has the highest profit of %d", branch2profit);
        printf("Branch 3 has the highest profit of %d", branch3profit);
    }
    else if(branch1profit == branch2profit == branch3profit){
        printf("Branch 1 has the highest profit of %d", branch1profit);
        printf("Branch 2 has the highest profit of %d", branch2profit);
        printf("Branch 3 has the highest profit of %d", branch3profit);
    }
    }



    

   



    
    for(int i = 0; i < 3; i++){
        
        finalprices[i][1] = finalprices[i][1] * 0.9;
        
    }



    
   printf("----After 10 percent discount----");
